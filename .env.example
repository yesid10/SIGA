# ==============================================================================
# SIGA - Entorno Unificado de Configuración (Single Source of Truth)
# Copia este archivo a .env y ajusta los valores para tu entorno local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=siga-dev-password
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 2. Puertos de Servicios Docker
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 3. Seguridad, Token JWT e Integración Externa
# ------------------------------------------------------------------------------
JWT_SECRET=local-development-secret-change-before-production-123456
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://ghost-kitchen-nusq.onrender.com
EXTERNAL_API_KEY=siga-uds-external-access-key-2026,QkwVBVttNYjyshnyoRv3z9QiP7uso5ZQD_kzadrWU6k
GHOST_KITCHEN_URL=https://ghost-kitchen-nusq.onrender.com/api/v1/informes/
GHOST_KITCHEN_TOKEN=QkwVBVttNYjyshnyoRv3z9QiP7uso5ZQD_kzadrWU6k

# ------------------------------------------------------------------------------
# 4. Credenciales de Semilla Inicial (Administrador del Sistema)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@siga.local
SEED_ADMIN_PASSWORD=Admin123!

# ------------------------------------------------------------------------------
# 5. Firebase Authentication (Opcional - Google OAuth & Email)
# ------------------------------------------------------------------------------
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# ------------------------------------------------------------------------------
# 6. Frontend Web (Vite + React 19)
# ------------------------------------------------------------------------------
VITE_API_URL=/api
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 7. Cloudinary Storage (Almacenamiento en la Nube de Fotos y Avatares)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
